# ============================================
# Komodo - Orquestador de Agentes IA
# ============================================
# Komodo usa CLIs de IA (claude, codex, gemini) como terminales,
# NO APIs de pago. Asegúrate de tener instalado al menos uno.

# ============================================
# CLIs de Agentes (qué terminal usa cada agente)
# ============================================
# Opciones: claude, codex, gemini
# Puedes mezclarlos: Planner con gemini, Coder con claude, etc.

CLI_PLANNER=gemini
CLI_CODER=claude
CLI_REVIEWER=claude

# ============================================
# Firebase (para planning-task-mcp)
# ============================================

# Ruta al archivo de credenciales de Firebase
GOOGLE_APPLICATION_CREDENTIALS=./skills/planning-task-mcp/serviceAccountKey.json

# URL de la base de datos en tiempo real de Firebase
FIREBASE_DATABASE_URL=https://planning-task-default-rtdb.europe-west1.firebasedatabase.app

# ============================================
# Usuario por defecto (planning-task-mcp)
# ============================================

# UID del usuario en Firebase Auth
DEFAULT_USER_ID=

# Nombre del usuario
DEFAULT_USER_NAME=

# ============================================
# GitHub
# ============================================

# Token de GitHub (opcional si ya tienes gh autenticado)
GITHUB_TOKEN=ghp_...

# ============================================
# Komodo Config
# ============================================

# Puerto del WebSocket server para el dashboard (default: 3001)
WS_PORT=3001

# ============================================
# API Server (control externo via HTTP)
# ============================================

# Habilitar servidor HTTP REST para control externo (default: false)
API_SERVER=false

# Puerto del API server (default: 3002)
API_PORT=3002

# API key requerida para autenticar requests (header X-Komodo-Key)
# Requerida si API_SERVER=true. Usa un string aleatorio seguro.
KOMODO_API_KEY=

# Máximo de rondas de review coder↔reviewer (default: 5)
MAX_REVIEW_CYCLES=5

# Auto-merge: si true, Komodo mergea la PR y pasa la tarea a "done" automáticamente
# Si false, para después del APPROVED y tú decides cuándo mergear (default: true)
AUTO_MERGE=true

# Project ID por defecto (evita pasar -p en cada ejecución)
DEFAULT_PROJECT_ID=

# ============================================
# Browser MCP (Chrome DevTools)
# ============================================

# Habilitar Chrome DevTools MCP para que los agentes inspeccionen el navegador
# Permite acceso a consola, screenshots, DOM, network, performance (default: false)
ENABLE_BROWSER_MCP=false

# Puerto de Chrome remote debugging (default: 9222)
CHROME_DEBUGGER_PORT=9222

# ============================================
# Telegram Bot
# ============================================

# Habilitar bot de Telegram (default: false)
ENABLE_TELEGRAM=false

# Token del bot (obtener de @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID principal para notificaciones (opcional)
TELEGRAM_CHAT_ID=

# IDs de usuarios autorizados, separados por coma (ej: 123456789,987654321)
TELEGRAM_ALLOWED_USERS=

# Timeout para respuestas de Claude Code via terminal (ms, default: 120000 = 2min)
TELEGRAM_CLAUDE_TIMEOUT=120000

# ============================================
# Triage / Complexity Classification
# ============================================

# Thresholds para clasificar complejidad de tareas (score 1-10)
# score 1-TRIVIAL_MAX = trivial, TRIVIAL_MAX+1-STANDARD_MAX = standard, STANDARD_MAX+1-10 = complex
COMPLEXITY_TRIVIAL_MAX=3
COMPLEXITY_STANDARD_MAX=6

# ============================================
# Model Selection (selección automática por complejidad)
# ============================================

# Mapeo complejidad→modelo por CLI y rol
# Formato: trivialModel,standardModel,complexModel
# Si no se configura, se usan los defaults internos
# Ejemplo: MODEL_MAP_CLAUDE_CODER=haiku,sonnet,opus

#MODEL_MAP_CLAUDE_PLANNER=sonnet,sonnet,opus
#MODEL_MAP_CLAUDE_CODER=sonnet,sonnet,opus
#MODEL_MAP_CLAUDE_REVIEWER=haiku,sonnet,sonnet
#MODEL_MAP_CODEX_PLANNER=codex-mini,o4-mini,o3
#MODEL_MAP_CODEX_CODER=codex-mini,o4-mini,o3
#MODEL_MAP_CODEX_REVIEWER=codex-mini,o4-mini,o3
#MODEL_MAP_GEMINI_PLANNER=gemini-2.0-flash,gemini-2.5-pro,gemini-2.5-pro
#MODEL_MAP_GEMINI_CODER=gemini-2.0-flash,gemini-2.5-pro,gemini-2.5-pro
#MODEL_MAP_GEMINI_REVIEWER=gemini-2.0-flash,gemini-2.5-pro,gemini-2.5-pro

# Override global: fuerza un modelo específico para un rol (ignora complejidad)
# Ejemplo: FORCE_MODEL_CODER=opus
#FORCE_MODEL_PLANNER=
#FORCE_MODEL_CODER=
#FORCE_MODEL_REVIEWER=

# ============================================
# Rate Limit Fallback
# ============================================

# Habilitar auto-fallback a CLI alternativo cuando se detecta rate limit (default: true)
RATE_LIMIT_FALLBACK=true

# Orden de prioridad de CLIs para fallback, separados por coma
FALLBACK_CLI_ORDER=claude,codex,gemini

# Tiempo de cooldown en minutos antes de reintentar un CLI con rate limit (default: 15)
RATE_LIMIT_COOLDOWN_MINUTES=15

# ============================================
# Scheduler: Execution Windows
# ============================================

# Time windows when Komodo can execute tasks (comma-separated, HH:MM-HH:MM)
# Supports windows that cross midnight (e.g., 22:00-06:00)
# Empty or unset = 24/7 execution (no restrictions)
#SCHEDULE=02:00-06:00,14:00-18:00

# IANA timezone for schedule windows (e.g., Europe/Madrid, America/New_York)
# Empty = system timezone
#SCHEDULE_TIMEZONE=Europe/Madrid

# ============================================
# GitHub Issue Sync (auto-crear tareas desde Issues)
# ============================================

# Habilitar sincronización de GitHub Issues al backlog (default: false)
GITHUB_ISSUE_SYNC=false

# Intervalo de polling en minutos (default: 5)
GITHUB_ISSUE_POLL_MINUTES=5

# Label que activa la sincronización (default: komodo)
GITHUB_ISSUE_LABEL=komodo

# Repositorio a monitorear (formato: owner/repo)
GITHUB_ISSUE_REPO=

# ============================================
# Smart Task Ordering (context affinity)
# ============================================

# Boost factor for tasks sharing context with the previously completed task (0-1)
# 0.2 means a 20% priority boost at maximum affinity. Set to 0 to disable.
CONTEXT_AFFINITY_BOOST=0.2

# ============================================
# Pre-PR Test Execution
# ============================================

# Run tests before opening PRs (default: true)
PRE_PR_TESTS=true

# Test command (default: auto — detects from package.json, pytest, go test, etc.)
# Set explicitly to override: PRE_PR_TEST_CMD=npm test
PRE_PR_TEST_CMD=auto

# ============================================
# CI Monitor (watch GitHub Actions after merge)
# ============================================

# Monitor GitHub Actions after merging PRs (default: false)
CI_MONITOR=false

# Timeout in minutes to wait for CI run to complete (default: 15)
CI_MONITOR_TIMEOUT_MINUTES=15

# Auto-revert PRs that break CI after merge (default: false, requires opt-in)
# When enabled: creates revert PR, auto-merges it, returns task to to-do
AUTO_REVERT=false

# ============================================
# Budget Manager (control de costes de API)
# ============================================

# Presupuesto diario en USD (0 = sin límite, default: 10)
DAILY_BUDGET_USD=10

# Presupuesto semanal en USD (0 = sin límite, default: 50)
WEEKLY_BUDGET_USD=50

# Porcentaje del presupuesto que activa un aviso (default: 0.8 = 80%)
BUDGET_WARNING_THRESHOLD=0.8

# Coste estimado por invocación de agente en USD (default: 0.05)
ESTIMATED_COST_PER_INVOCATION=0.05

# ============================================
# Plugins (extensiones personalizadas)
# ============================================

# Directorio donde Komodo busca plugins (default: ./plugins)
PLUGINS_DIR=./plugins

# Plugins habilitados, separados por coma (vacío = ninguno)
# Cada nombre debe coincidir con un subdirectorio o archivo .js en PLUGINS_DIR
# Ejemplo: ENABLED_PLUGINS=security-audit,doc-gen
ENABLED_PLUGINS=

# ============================================
# SonarQube / SonarCloud (análisis estático)
# ============================================

# Habilitar análisis con SonarQube (default: false)
ENABLE_SONAR=false

# Token de autenticación (generar en SonarQube > My Account > Security)
SONAR_TOKEN=

# URL del servidor SonarQube (o https://sonarcloud.io para SonarCloud)
SONAR_HOST_URL=

# Project key en SonarQube (ej: my-org_my-project)
SONAR_PROJECT_KEY=
